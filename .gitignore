# --- Godot 4 ---
# Editor/engine cache. Regenerated on open; never commit it.
.godot/
# Legacy Godot 3 cache, kept so a stray import doesn't get committed.
.import/

# --- Exports / builds ---
build/
builds/
export/
*.pck
*.zip
*.x86_64
*.exe
*.dmg
*.apk
*.aab

# export_presets.cfg IS committed: CI needs it to produce the web build, and
# the Web preset holds no secrets. If a signed desktop or mobile preset is ever
# added, its keystore path and password must go in a separate local file or an
# Actions secret -- never in here.

# --- Mono / C# (unused today, guarded in case we ever add a C# module) ---
.mono/
data_*/
mono_crash.*.json
bin/
obj/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# Local screenshot scratch
shots/
